{
  "name": "sidepact",
  "version": "0.5.0",
  "description": "A Markdown handoff bridge for frontend, backend, and cross-platform AI agents",
  "type": "module",
  "bin": {
    "sidepact": "bin/sidepact.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.zh-TW.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "examples",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "sidepact",
    "ai-agents",
    "agent-handoff",
    "cross-repository",
    "frontend",
    "backend",
    "markdown",
    "cli",
    "git",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatsonChen/sidepact.git"
  },
  "homepage": "https://github.com/WatsonChen/sidepact#readme",
  "bugs": {
    "url": "https://github.com/WatsonChen/sidepact/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
